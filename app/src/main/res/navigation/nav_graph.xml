<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.oleje.transactions_statistic.fragments.HomeFragment"
        android:label="Мої картки"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_transactionListFragment"
            app:destination="@id/transactionListFragment" />
        <action
            android:id="@+id/action_homeFragment_to_addCardFragment"
            app:destination="@id/addCardFragment" />
    </fragment>

    <fragment
        android:id="@+id/addCardFragment"
        android:name="com.oleje.transactions_statistic.fragments.AddCardFragment"
        android:label="Додати картку"
        tools:layout="@layout/fragment_add_card" />

    <fragment
        android:id="@+id/transactionListFragment"
        android:name="com.oleje.transactions_statistic.fragments.TransactionListFragment"
        android:label="Транзакції"
        tools:layout="@layout/fragment_transaction_list">
        <argument
            android:name="cardNum"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.oleje.transactions_statistic.fragments.SettingsFragment"
        android:label="Налаштування"
        tools:layout="@layout/fragment_settings" />

    <action
        android:id="@+id/action_global_settingsFragment"
        app:destination="@id/settingsFragment" />

</navigation>